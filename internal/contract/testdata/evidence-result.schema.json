{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secrets-bridge.io/schemas/gateway/v1/evidence-result.schema.json",
  "title": "EvidenceResult",
  "description": "Metadata-only evidence for one attempt of one observation task, posted to POST /api/v1/gateways/{id}/tasks/{task_id}/result. Every object is closed (additionalProperties false), every string is an enum, an id, a timestamp or a tightly patterned Kubernetes or ArgoCD identifier, and there is no free-text field, so the contract has no place to put a secret value, a hash of a value, a manifest, an env var, an annotation value, a log line or an error message. The Gateway proposes stage outcomes; the control plane recomputes them from facts and alone computes the task verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "gateway_id",
    "replica_id",
    "gateway_version",
    "started_at",
    "finished_at",
    "attempt_status",
    "stages",
    "clock"
  ],
  "properties": {
    "schema_version": {
      "const": "gateway.evidence-result/v1"
    },
    "task_id": {
      "$ref": "#/$defs/uuid"
    },
    "attempt_id": {
      "$ref": "#/$defs/uuid",
      "description": "Must equal the attempt_id of the current claim. Together with task_id it is the idempotency key."
    },
    "gateway_id": {
      "$ref": "#/$defs/uuid",
      "description": "Must equal the :id in the path and the authenticated Gateway."
    },
    "replica_id": {
      "$ref": "#/$defs/uuid",
      "description": "Random UUIDv4 generated by the Gateway process at start. Informational and for audit and per-replica limits. Fencing uses attempt_id, not replica_id."
    },
    "gateway_version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]{1,32})?$",
      "maxLength": 64
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "attempt_status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "refused"
      ],
      "description": "completed: every connector_ref was attempted. partial: the Gateway stopped early (lease about to expire, shutdown, connector budget). refused: the task failed local validation and nothing was read; refusal_reason is required."
    },
    "refusal_reason": {
      "type": "string",
      "enum": [
        "unknown_connector",
        "unbound_target",
        "stage_not_supported_by_connector",
        "scope_mismatch",
        "schema_violation",
        "unsupported_schema_version",
        "deadline_passed"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/stageObservation"
      }
    },
    "clock": {
      "$ref": "#/$defs/clock"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt_status": {
            "const": "refused"
          }
        },
        "required": [
          "attempt_status"
        ]
      },
      "then": {
        "required": [
          "refusal_reason"
        ],
        "properties": {
          "stages": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "refusal_reason"
          ]
        },
        "properties": {
          "stages": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "description": "Kubernetes object name (RFC 1123 subdomain).",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$",
      "maxLength": 253
    },
    "dnsLabel": {
      "type": "string",
      "description": "Kubernetes namespace (RFC 1123 label).",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "k8sResourceVersion": {
      "type": "string",
      "description": "metadata.resourceVersion. Opaque to clients; compared only for equality.",
      "pattern": "^[0-9A-Za-z]{1,64}$"
    },
    "nonNegInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "conditionStatus": {
      "type": "string",
      "enum": [
        "True",
        "False",
        "Unknown"
      ]
    },
    "conditionReason": {
      "type": "string",
      "description": "Kubernetes condition reason, which by API convention is a CamelCase token. The free-text condition message is never copied.",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "observed",
        "not_observed",
        "not_applicable",
        "unverifiable",
        "failed",
        "error"
      ],
      "description": "Stage outcome proposed by the Gateway. observed: the resource state is consistent with the change and ordered after it (see linkage). not_observed: the resource was read and does not (yet) reflect the change; non-terminal. not_applicable: the stage cannot apply to this target (for example a volume-mounted consumer with no restart expected); a caveat says why. unverifiable: the resource can be read but cannot carry the needed link, or will not change before the deadline. failed: positive evidence of failure after the change (ESO Ready=False after executed_at, or Progressing reason ProgressDeadlineExceeded on a rollout after the refresh). error: the connector could not read the resource; error_code says why; non-terminal."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "caveat": {
      "type": "string",
      "enum": [
        "argocd_health_not_proof",
        "eso_status_has_no_provider_version",
        "provider_version_missing",
        "temporal_inference_only",
        "refresh_before_change",
        "refresh_time_within_skew",
        "remote_ref_not_checked",
        "remote_ref_mismatch",
        "remote_version_pinned_other",
        "multiple_externalsecrets_for_target",
        "data_from_extract_or_find",
        "rollout_not_triggered_by_change",
        "reload_mechanism_unknown",
        "rollout_in_progress",
        "generation_not_observed",
        "argocd_operation_unrelated",
        "argocd_app_has_multiple_sources",
        "clock_skew_suspected",
        "observed_before_not_before",
        "resource_deleted_during_observation",
        "refresh_interval_exceeds_deadline",
        "volume_refresh_not_observable",
        "subpath_mount_not_refreshed",
        "rollout_paused",
        "zero_replicas",
        "replicaset_reused"
      ]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "connector_unreachable",
        "connector_timeout",
        "connector_unauthorized",
        "connector_forbidden",
        "resource_not_found",
        "api_version_not_served",
        "response_too_large",
        "rate_limited",
        "tls_verification_failed",
        "internal",
        "target_identity_changed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_id",
        "target_id",
        "api"
      ],
      "properties": {
        "connector_id": {
          "$ref": "#/$defs/localId"
        },
        "target_id": {
          "$ref": "#/$defs/localId"
        },
        "api": {
          "type": "string",
          "enum": [
            "kubernetes",
            "argocd"
          ]
        }
      }
    },
    "resourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "kind",
        "namespace",
        "name"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "enum": [
            "external-secrets.io/v1",
            "external-secrets.io/v1beta1",
            "apps/v1",
            "argoproj.io/v1alpha1"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "ExternalSecret",
            "Deployment",
            "Application"
          ]
        },
        "namespace": {
          "$ref": "#/$defs/dnsLabel"
        },
        "name": {
          "$ref": "#/$defs/dnsSubdomain"
        },
        "uid": {
          "$ref": "#/$defs/uuid"
        },
        "identity_digest": {
          "$ref": "#/$defs/targetIdentityDigest"
        },
        "resource_version": {
          "$ref": "#/$defs/k8sResourceVersion"
        },
        "generation": {
          "$ref": "#/$defs/nonNegInt"
        }
      },
      "description": "Identity of the object read. namespace and name are the same values the Gateway advertised in its catalog for this target. Kubernetes stages may carry uid; Argo CD stages carry identity_digest instead and never the raw uid."
    },
    "stageObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/esoSyncObservation"
        },
        {
          "$ref": "#/$defs/workloadRolloutObservation"
        },
        {
          "$ref": "#/$defs/argocdContextObservation"
        }
      ]
    },
    "esoSyncObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "source",
        "observed_at",
        "outcome",
        "confidence",
        "caveats",
        "linkage"
      ],
      "properties": {
        "stage": {
          "const": "eso_sync"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resource": {
          "$ref": "#/$defs/resourceIdentity"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "caveats": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caveat"
          }
        },
        "error_code": {
          "$ref": "#/$defs/errorCode"
        },
        "facts": {
          "$ref": "#/$defs/esoFacts"
        },
        "linkage": {
          "$ref": "#/$defs/linkage"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/errorRule"
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "observed"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "linkage": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "properties": {
            "resource": {
              "not": {
                "required": [
                  "identity_digest"
                ]
              }
            }
          }
        }
      ]
    },
    "workloadRolloutObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "source",
        "observed_at",
        "outcome",
        "confidence",
        "caveats",
        "linkage"
      ],
      "properties": {
        "stage": {
          "const": "workload_rollout"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resource": {
          "$ref": "#/$defs/resourceIdentity"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "caveats": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caveat"
          }
        },
        "error_code": {
          "$ref": "#/$defs/errorCode"
        },
        "facts": {
          "$ref": "#/$defs/rolloutFacts"
        },
        "linkage": {
          "type": "string",
          "enum": [
            "time_ordered",
            "none"
          ]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/errorRule"
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "observed"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "linkage": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        },
        {
          "properties": {
            "resource": {
              "not": {
                "required": [
                  "identity_digest"
                ]
              }
            }
          }
        }
      ]
    },
    "argocdContextObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "source",
        "observed_at",
        "outcome",
        "confidence",
        "caveats",
        "linkage"
      ],
      "properties": {
        "stage": {
          "const": "argocd_context"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resource": {
          "$ref": "#/$defs/resourceIdentity"
        },
        "outcome": {
          "description": "ArgoCD context is never proof that a secret change rolled out. It has no failed or not_applicable outcome and never contributes to a verdict.",
          "type": "string",
          "enum": [
            "observed",
            "not_observed",
            "unverifiable",
            "error"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "none"
          ]
        },
        "caveats": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "contains": {
            "const": "argocd_health_not_proof"
          },
          "items": {
            "$ref": "#/$defs/caveat"
          }
        },
        "error_code": {
          "$ref": "#/$defs/errorCode"
        },
        "facts": {
          "$ref": "#/$defs/argocdFacts"
        },
        "linkage": {
          "const": "none"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/errorRule"
        },
        {
          "properties": {
            "resource": {
              "not": {
                "required": [
                  "uid"
                ]
              }
            }
          }
        }
      ]
    },
    "errorRule": {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "error_code"
        ],
        "properties": {
          "confidence": {
            "const": "none"
          }
        },
        "not": {
          "required": [
            "facts"
          ]
        }
      },
      "else": {
        "required": [
          "resource",
          "facts"
        ],
        "not": {
          "required": [
            "error_code"
          ]
        }
      }
    },
    "esoFacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Copied from ExternalSecret .status and .spec. The Gateway never reads the target Kubernetes Secret.",
      "required": [
        "ready_status"
      ],
      "properties": {
        "ready_status": {
          "$ref": "#/$defs/conditionStatus",
          "description": ".status.conditions[type=Ready].status"
        },
        "ready_reason": {
          "$ref": "#/$defs/conditionReason",
          "description": ".status.conditions[type=Ready].reason, for example SecretSynced or SecretSyncedError"
        },
        "ready_last_transition_time": {
          "$ref": "#/$defs/timestamp",
          "description": ".status.conditions[type=Ready].lastTransitionTime"
        },
        "refresh_time": {
          "$ref": "#/$defs/timestamp",
          "description": ".status.refreshTime"
        },
        "synced_resource_version": {
          "type": "string",
          "description": ".status.syncedResourceVersion. Describes the ExternalSecret object, not the provider secret. Verify its exact format against the ESO version in use; it is compared only for equality.",
          "pattern": "^[0-9A-Za-z-]{1,128}$"
        },
        "observed_generation_matches": {
          "type": "boolean",
          "description": "True when the Gateway can tell that .status.syncedResourceVersion corresponds to the current .metadata.generation. The comparison rule depends on the ESO version (verify); send false when unsure."
        },
        "refresh_interval_seconds": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".spec.refreshInterval converted to seconds"
        },
        "remote_ref_match": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "not_checked",
            "extract_or_find"
          ],
          "description": "Whether any .spec.data[].remoteRef.key or .spec.dataFrom[].extract.key equals expected_change.secret_ref.name. The keys themselves are not sent."
        },
        "remote_version_pin": {
          "type": "string",
          "enum": [
            "none",
            "matches_expected",
            "other_version"
          ],
          "description": "Result of comparing .spec.data[].remoteRef.version (if set) with expected_change.provider_version_id. The pinned value is not sent."
        },
        "target_secret_name": {
          "$ref": "#/$defs/dnsSubdomain",
          "description": ".spec.target.name, or the ExternalSecret name when unset. Name only; the Secret object is never read."
        }
      }
    },
    "rolloutFacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Copied from Deployment .metadata, .spec scalars and .status, and from owned ReplicaSet metadata. Decoded from the raw response into a projected struct. Container specs, env values, volumes and annotation values are never copied.",
      "required": [
        "generation",
        "observed_generation",
        "spec_replicas"
      ],
      "properties": {
        "generation": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".metadata.generation"
        },
        "observed_generation": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.observedGeneration"
        },
        "spec_replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".spec.replicas, or 1 when unset"
        },
        "paused": {
          "type": "boolean",
          "description": ".spec.paused, false when unset"
        },
        "progress_deadline_seconds": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".spec.progressDeadlineSeconds, or 600 when unset"
        },
        "replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.replicas (includes old pods during a rollout)"
        },
        "updated_replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.updatedReplicas"
        },
        "ready_replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.readyReplicas"
        },
        "available_replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.availableReplicas"
        },
        "unavailable_replicas": {
          "$ref": "#/$defs/nonNegInt",
          "description": ".status.unavailableReplicas"
        },
        "progressing_status": {
          "$ref": "#/$defs/conditionStatus",
          "description": ".status.conditions[type=Progressing].status"
        },
        "progressing_reason": {
          "$ref": "#/$defs/conditionReason",
          "description": ".status.conditions[type=Progressing].reason, for example NewReplicaSetAvailable or ProgressDeadlineExceeded"
        },
        "available_status": {
          "$ref": "#/$defs/conditionStatus",
          "description": ".status.conditions[type=Available].status"
        },
        "deployment_revision": {
          "type": "string",
          "description": "metadata.annotations[deployment.kubernetes.io/revision] on the Deployment",
          "pattern": "^[0-9]{1,12}$"
        },
        "newest_replicaset_created_at": {
          "$ref": "#/$defs/timestamp",
          "description": "creationTimestamp of the ReplicaSet owned by the Deployment whose revision annotation equals deployment_revision"
        },
        "rollout_trigger": {
          "type": "string",
          "enum": [
            "pod_template_annotation_after_change",
            "pod_template_annotation_before_change",
            "replicaset_created_after_change",
            "replicaset_revision_bumped_after_change",
            "no_rollout_since_change",
            "not_checked"
          ],
          "description": "How the rollout relates in time to the ESO refresh. replicaset_revision_bumped_after_change needs task.rollout_baseline. Annotation keys and values are never sent; the only annotation value the Gateway reads is the kubectl.kubernetes.io/restartedAt timestamp."
        },
        "reload_mechanism": {
          "type": "string",
          "enum": [
            "reloader_annotation",
            "checksum_annotation",
            "none_detected",
            "not_checked"
          ],
          "description": "Which local mechanism, if any, is configured to restart pods on Secret change. Detected by presence of allowlisted annotation keys, never by reading values."
        },
        "consumption_mode": {
          "type": "string",
          "enum": [
            "env",
            "volume",
            "subpath_volume",
            "mixed",
            "not_referenced",
            "unknown"
          ],
          "description": "How the pod template consumes the ExternalSecret target Secret, derived inside the Gateway from envFrom[].secretRef.name, env[].valueFrom.secretKeyRef.name, volumes[].secret.secretName and volumeMounts[].subPath presence. Names are compared locally and not sent."
        }
      }
    },
    "argocdFacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Copied from ArgoCD Application .status. Context only; never proof that a secret change rolled out.",
      "required": [
        "sync_status",
        "health_status"
      ],
      "properties": {
        "sync_status": {
          "type": "string",
          "enum": [
            "Synced",
            "OutOfSync",
            "Unknown"
          ],
          "description": ".status.sync.status"
        },
        "health_status": {
          "type": "string",
          "enum": [
            "Healthy",
            "Progressing",
            "Degraded",
            "Suspended",
            "Missing",
            "Unknown"
          ],
          "description": ".status.health.status"
        },
        "sync_revision": {
          "type": "string",
          "description": ".status.sync.revision (Git commit SHA, Helm chart version or OCI digest)",
          "pattern": "^[0-9A-Za-z._+:-]{1,128}$"
        },
        "operation_phase": {
          "type": "string",
          "enum": [
            "Running",
            "Succeeded",
            "Failed",
            "Error",
            "Terminating"
          ],
          "description": ".status.operationState.phase"
        },
        "operation_started_at": {
          "$ref": "#/$defs/timestamp",
          "description": ".status.operationState.startedAt"
        },
        "operation_finished_at": {
          "$ref": "#/$defs/timestamp",
          "description": ".status.operationState.finishedAt"
        },
        "reconciled_at": {
          "$ref": "#/$defs/timestamp",
          "description": ".status.reconciledAt"
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cp_offset_ms"
      ],
      "description": "Measured clock offsets, Gateway clock minus the peer clock, from the Date header of the most recent responses. The control plane applies skew = margin + |cp_offset_ms| + |apiserver_offset_ms|.",
      "properties": {
        "cp_offset_ms": {
          "type": "integer",
          "minimum": -86400000,
          "maximum": 86400000,
          "description": "Gateway clock minus control-plane clock, from the claim response Date header."
        },
        "apiserver_offset_ms": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": -86400000,
              "maximum": 86400000
            }
          ],
          "description": "Gateway clock minus Kubernetes API server clock, from the Date header of the Kubernetes responses in this attempt. Null when no Kubernetes call was made."
        }
      }
    },
    "linkage": {
      "type": "string",
      "enum": [
        "version_pinned",
        "time_ordered",
        "none"
      ],
      "description": "How the observation is tied to the change. version_pinned: the ExternalSecret pins remoteRef.version to the expected provider_version_id. time_ordered: ordered after the change by timestamps only. none: no link."
    },
    "targetIdentityDigest": {
      "type": "string",
      "description": "Scoped identity digest of the object read: \"d-\" and the first 130 bits, in lower-case base32, of SHA-256(\"sb-argocd-target/v1\" || uint32 big-endian len(connector_id) || connector_id || uid), the same derivation as a discovered target id (ADR 0002 C3). One-way; the raw uid of an Argo CD Application never leaves the customer boundary.",
      "pattern": "^d-[a-z2-7]{26}$"
    }
  }
}
