{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secrets-bridge.io/schemas/gateway/v2/gateway-discovery-snapshot.schema.json",
  "title": "GatewayDiscoverySnapshot",
  "description": "The E9 200 body of GET /api/v1/gateways/{id}/connectors/{connector_id}/snapshot (docs/design/discovery-contract.md section 4): the latest accepted sealed snapshot of the connector, exactly as uploaded. The control plane cannot read or forge it. A replica rebuilds the associated data from its own gateway_id, the connector_id it asked for, and the generation and discovered_at below; any change to them fails the open.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connector_id", "generation", "discovered_at", "snapshot"],
  "properties": {
    "schema_version": {"const": "gateway.discovery-snapshot/v1"},
    "connector_id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "discovered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "nonce", "ciphertext"],
      "properties": {
        "alg": {"const": "A256GCM+HKDF-SHA256/v1"},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9+/]{16}$"},
        "ciphertext": {
          "type": "string",
          "minLength": 24,
          "maxLength": 2000000,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
